 "font_size": 14,
 "html": "<style>\n    .invoice-container {\n        font-family: 'Helvetica Neue', Arial, sans-serif;\n        max-width: 800px;\n        margin: 0 auto;\n        color: #333;\n    }\n    \n    .invoice-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        margin: 30px 0;\n        padding: 0 20px;\n    }\n    \n    .invoice-title {\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        color: white;\n        padding: 15px 25px;\n        border-radius: 8px;\n        font-size: 24px;\n        font-weight: bold;\n        letter-spacing: 1px;\n    }\n    \n    .invoice-details {\n        background-color: #f8f9fa;\n        padding: 20px;\n        border-radius: 8px;\n        border-left: 4px solid #667eea;\n    }\n    \n    .customer-info {\n        background-color: #fff;\n        padding: 20px;\n        border: 2px solid #e9ecef;\n        border-radius: 8px;\n        margin: 20px 0;\n    }\n    \n    .invoice-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 30px 0;\n        background: white;\n        border-radius: 8px;\n        overflow: hidden;\n        box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n    }\n    \n    .invoice-table thead {\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        color: white;\n    }\n    \n    .invoice-table th {\n        padding: 15px 12px;\n        text-align: left;\n        font-weight: 600;\n        font-size: 14px;\n        letter-spacing: 0.5px;\n    }\n    \n    .invoice-table td {\n        padding: 12px;\n        border-bottom: 1px solid #e9ecef;\n        font-size: 14px;\n    }\n    \n    .invoice-table tbody tr:hover {\n        background-color: #f8f9fa;\n    }\n    \n    .total-section {\n        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);\n        padding: 20px;\n        border-radius: 8px;\n        margin: 30px 0;\n        border-left: 4px solid #28a745;\n    }\n    \n    .total-row {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin: 8px 0;\n        font-size: 16px;\n    }\n    \n    .grand-total {\n        font-size: 20px;\n        font-weight: bold;\n        color: #2c3e50;\n        border-top: 2px solid #667eea;\n        padding-top: 15px;\n        margin-top: 15px;\n    }\n    \n    .status-badge {\n        display: inline-block;\n        padding: 8px 16px;\n        border-radius: 20px;\n        font-weight: bold;\n        font-size: 12px;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n    }\n    \n    .status-paid { background-color: #d4edda; color: #155724; }\n    .status-sent { background-color: #fff3cd; color: #856404; }\n    .status-draft { background-color: #f8d7da; color: #721c24; }\n    .status-overdue { background-color: #f5c6cb; color: #721c24; }\n    \n    .payment-terms {\n        background-color: #e3f2fd;\n        padding: 15px;\n        border-radius: 8px;\n        margin: 20px 0;\n        border-left: 4px solid #2196f3;\n    }\n    \n    @media print {\n        .invoice-container {\n            max-width: none;\n            margin: 0;\n        }\n        .invoice-table {\n            box-shadow: none;\n        }\n    }\n</style>\n\n<div class=\"invoice-container\">\n    <!-- Invoice Header -->\n    <div class=\"invoice-header\">\n        <div>\n            <div class=\"invoice-title\">INVOICE</div>\n            <div class=\"invoice-details\">\n                <p><strong>Invoice #:</strong> {{ doc.name }}</p>\n                <p><strong>Date:</strong> {{ frappe.utils.formatdate(doc.invoice_date) }}</p>\n                {% if doc.due_date %}\n                <p><strong>Due Date:</strong> {{ frappe.utils.formatdate(doc.due_date) }}</p>\n                {% endif %}\n                {% if doc.customer_order %}\n                <p><strong>Order #:</strong> {{ doc.customer_order }}</p>\n                {% endif %}\n            </div>\n        </div>\n        \n        <div>\n            {% if doc.status %}\n            <div class=\"status-badge status-{{ doc.status.lower() }}\">\n                {{ doc.status }}\n            </div>\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- Customer Information -->\n    <div class=\"customer-info\">\n        <h3 style=\"margin: 0 0 15px 0; color: #2c3e50; border-bottom: 2px solid #667eea; padding-bottom: 10px;\">\n            Bill To:\n        </h3>\n        <p style=\"font-size: 18px; font-weight: bold; margin: 0; color: #2c3e50;\">\n            {{ doc.customer }}\n        </p>\n        <p style=\"color: #6c757d; margin: 5px 0;\">Customer</p>\n    </div>\n\n    <!-- Items Table -->\n    <table class=\"invoice-table\">\n        <thead>\n            <tr>\n                <th>Product</th>\n                <th style=\"text-align: center; width: 80px;\">Qty</th>\n                <th style=\"text-align: right; width: 100px;\">Rate</th>\n                <th style=\"text-align: right; width: 120px;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.invoice_items %}\n            <tr>\n                <td>\n                    <strong>{{ item.product }}</strong>\n                </td>\n                <td style=\"text-align: center;\">{{ item.quantity }}</td>\n                <td style=\"text-align: right;\">{{ frappe.utils.fmt_money(item.rate) }}</td>\n                <td style=\"text-align: right; font-weight: bold;\">\n                    {{ frappe.utils.fmt_money(item.amount) }}\n                </td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- Total Section -->\n    <div class=\"total-section\">\n        <div class=\"total-row\">\n            <span><strong>Subtotal:</strong></span>\n            <span><strong>{{ frappe.utils.fmt_money(doc.total_amount) }}</strong></span>\n        </div>\n        \n        {% if doc.paid_amount and doc.paid_amount > 0 %}\n        <div class=\"total-row\">\n            <span>Paid Amount:</span>\n            <span style=\"color: #28a745;\">{{ frappe.utils.fmt_money(doc.paid_amount) }}</span>\n        </div>\n        {% endif %}\n        \n        <div class=\"total-row grand-total\">\n            <span>Amount Due:</span>\n            <span>{{ frappe.utils.fmt_money(doc.outstanding_amount or doc.total_amount) }}</span>\n        </div>\n    </div>\n\n    <!-- Payment Terms -->\n    {% if doc.outstanding_amount and doc.outstanding_amount > 0 %}\n    <div class=\"payment-terms\">\n        <h4 style=\"margin: 0 0 10px 0; color: #2c3e50;\">Payment Information</h4>\n        <p style=\"margin: 5px 0;\">Please make payment by the due date to avoid late fees.</p>\n        <p style=\"margin: 5px 0;\">Thank you for choosing our services!</p>\n    </div>\n    {% endif %}\n</div>",
